            "typeparam",
            "unfixable",
            "unmanaged",
            "Vorbis",
            "Wamd",
            "Xbehave",
            "Xunit",
        ],
        "[yaml]": {
            "editor.insertSpaces": true,
            "editor.tabSize": 2,
            "editor.defaultFormatter": "redhat.vscode-yaml",
        },
        "omnisharp.autoStart": true,
        "omnisharp.enableEditorConfigSupport": true,
        "omnisharp.enableRoslynAnalyzers": true,
        "nugetpackagemanagergui.nuget.searchPackage.preRelease": true,
        "testing.maxVisibleTests": 5000,
        "dotnet.server.useOmnisharp": false,
        "testing.followRunningTest": false,
        "dotnet.test.logLevel": "trace",
        "dotnet.test.runSettingsPath": "./.runsettings",
        "dotnet.testWindow.discoveryTimeoutInSec": 900,
        "workbench.colorCustomizations": {
            "activityBar.activeBackground": "#836d62",
            "activityBar.activeBorder": "#40bf6a",
            "activityBar.background": "#836d62",
            "activityBar.foreground": "#e7e7e7",
            "activityBar.inactiveForeground": "#e7e7e799",
            "activityBarBadge.background": "#40bf6a",
            "activityBarBadge.foreground": "#15202b",
            "sash.hoverBorder": "#836d62",
            "statusBarItem.hoverBackground": "#836d62",
            "statusBarItem.remoteBackground": "#10301b",
            "statusBarItem.remoteForeground": "#e7e7e7",
            "titleBar.activeBackground": "#66554c",
            "titleBar.activeForeground": "#e7e7e7",
            "titleBar.inactiveBackground": "#66554c99",
            "titleBar.inactiveForeground": "#e7e7e799",
            "commandCenter.border": "#e7e7e799",
            "activityBarTop.activeBackground": "#836d62",
            "activityBarTop.background": "#836d62",
            "activityBarTop.foreground": "#e7e7e7",
            "activityBarTop.inactiveForeground": "#e7e7e799",
