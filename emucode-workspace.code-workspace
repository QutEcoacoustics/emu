    ],
    "settings": {
        "editor.formatOnSave": true,
        "cSpell.words": [
            "Arity",
            "configurator",
            "cref",
            "datestamp",
            "Divergic",
            "ecoacoustic",
            "Ecoacoustics",
            "flac",
            "FLAC",
            "hasher",
            "inheritdoc",
            "METATAG",
            "Newtonsoft",
            "Noda",
            "Nodatime",
